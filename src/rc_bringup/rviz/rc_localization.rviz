Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: map
    Frame Rate: 20
    Background Color: 35; 35; 35
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 40
    - Class: rviz_default_plugins/PointCloud2
      Name: Target PCD (gray)
      Enabled: true
      Topic:
        Value: /bbs_localization/map
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
      Color Transformer: FlatColor
      Color: 170; 170; 170
      Position Transformer: XYZ
      Style: Points
      Size (Pixels): 2
      Decay Time: 0
    - Class: rviz_default_plugins/PointCloud2
      Name: Verified scan (cyan)
      Enabled: true
      Topic:
        Value: /bbs_localization/aligned_scan
        Reliability Policy: Reliable
        Durability Policy: Volatile
        Depth: 1
      Color Transformer: FlatColor
      Color: 0; 255; 255
      Position Transformer: XYZ
      Style: Points
      Size (Pixels): 3
      Decay Time: 0.6
    - Class: rviz_default_plugins/PointCloud2
      Name: FAST-LIO scan (requires valid map-odom)
      Enabled: false
      Topic:
        Value: /cloud_registered
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        Depth: 1
      Color Transformer: FlatColor
      Color: 255; 190; 0
      Position Transformer: XYZ
      Style: Points
      Size (Pixels): 2
      Decay Time: 0.6
    - Class: rviz_default_plugins/Pose
      Name: Verified base_link pose (check status age)
      Enabled: true
      Topic:
        Value: /bbs_localization/pose
        Reliability Policy: Reliable
        Durability Policy: Volatile
        Depth: 1
      Shape: Axes
      Axes Length: 0.7
      Axes Radius: 0.05
    - Class: rviz_default_plugins/Marker
      Name: State quality timing
      Enabled: true
      Topic:
        Value: /bbs_localization/status_text
        Reliability Policy: Reliable
        Durability Policy: Volatile
        Depth: 1
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Show Axes: true
      Show Arrows: true
      Frame Timeout: 1
    - Class: rviz_default_plugins/RobotModel
      Name: Robot TF and geometry
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        Depth: 1
    - Class: rviz_default_plugins/Map
      Name: Optional 2D map (display only)
      Enabled: false
      Topic:
        Value: /map
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        Depth: 1
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
        Reliability Policy: Reliable
        Durability Policy: Volatile
        Depth: 5
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 20
      Pitch: 0.7
      Yaw: 0.8
      Focal Point:
        X: 0
        Y: 0
        Z: 0
Window Geometry:
  Width: 1400
  Height: 900
