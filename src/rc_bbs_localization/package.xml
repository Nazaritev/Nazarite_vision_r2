<?xml version="1.0"?>
<package format="3">
  <name>rc_bbs_localization</name>
  <version>0.1.0</version>
  <description>Independent asynchronous official 3D-BBS global search, GICP and temporal verification.</description>
  <maintainer email="dev@livoxtech.com">Nazarite maintainers</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_msgs</depend>
  <depend>pcl_conversions</depend>
  <depend>libpcl-all-dev</depend>
  <depend>libssl-dev</depend>
  <depend>yaml-cpp</depend>
  <depend>eigen</depend>
  <build_depend>libomp-dev</build_depend>
  <exec_depend>rc_bringup</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
